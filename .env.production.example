# Copy to a protected secret store; never commit the populated file.
SPRING_PROFILES_ACTIVE=production
SPRING_DATASOURCE_URL=jdbc:postgresql://db.internal:5432/open_banking?sslmode=verify-full&currentSchema=banking_protocol
SPRING_DATASOURCE_USERNAME=obg_runtime
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_SECRET
ASPSP_XS2A_BASE_URL=https://aspsp.example.com/api
ASPSP_XS2A_OAUTH_URL=https://aspsp.example.com/oauth/authorization-server
ASPSP_HBCI_BASE_URL=https://hbci.example.com/
OBG_ADMIN_LOGIN=REPLACE_WITH_ADMIN_LOGIN
OBG_ADMIN_PASSWORD=REPLACE_WITH_SECRET
OBG_TPP_PRIVATE_KEY=REPLACE_WITH_REGISTERED_TPP_PRIVATE_KEY
OBG_TPP_PUBLIC_KEY=REPLACE_WITH_REGISTERED_TPP_PUBLIC_KEY
OBG_EMBEDDED_UI_BASE_URL=https://consent.example.com
OBG_DATASAFE_PSU_PASSWORD=REPLACE_WITH_SECRET
OBG_DATASAFE_FINTECH_PASSWORD=REPLACE_WITH_SECRET
OBG_DATASAFE_FINTECH_USER_PASSWORD=REPLACE_WITH_SECRET
OBG_QWAC_KEYSTORE=/run/secrets/obg-qwac.p12
OBG_QWAC_KEYSTORE_PASSWORD=REPLACE_WITH_SECRET
FINAPI_API_URL=https://api.finapi.io
FINAPI_WEBFORM_API_URL=https://webform.finapi.io
FINAPI_CLIENT_ID=REPLACE_WITH_CLIENT_ID
FINAPI_CLIENT_SECRET=REPLACE_WITH_SECRET
